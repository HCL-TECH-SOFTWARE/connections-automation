      community.DbRuntimeUser: "{{ __db_username }}"
      community.DbRuntimePassword: "{{ __db_password }}"
      community.DBA.DbUser: "{{ __db_username }}"
      community.DBA.DbPassword: "{{ __db_password }}"
      community.DbConfigRoleName: "{{ __db_group }}"
      community.DbRuntimeRoleName: "{{ __db_group }}"

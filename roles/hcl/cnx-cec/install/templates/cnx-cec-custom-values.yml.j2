      feedback.DbRuntimeUser: "{{ __db_username }}"
      feedback.DbRuntimePassword: "{{ __db_password }}"
      feedback.DBA.DbUser: "{{ __db_username }}"
      feedback.DBA.DbPassword: "{{ __db_password }}"
      feedback.DbConfigRoleName: "{{ __db_group }}"
      feedback.DbRuntimeRoleName: "{{ __db_group }}"
      feedback.XDbName: "WPFDBK"
      feedback.DbNode: "pznNode"
      likeminds.DbType: "db2"

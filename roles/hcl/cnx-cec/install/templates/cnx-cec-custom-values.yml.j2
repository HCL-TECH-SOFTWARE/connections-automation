      release.DataSourceName: "wpreldbDS"
      release.DbUrl: "jdbc:db2://{{ __db_hostname }}:{{ __db_port }}/WPREL:returnAlias=0;"
      release.DbUser: "{{ __db_username }}"
      release.DbPassword: "{{ __db_password }}"
      release.DbRuntimeUser: "{{ __db_username }}"
      release.DbRuntimePassword: "{{ __db_password }}"
      release.DBA.DbUser: "{{ __db_username }}"
      release.DBA.DbPassword: "{{ __db_password }}"
      release.DbConfigRoleName: "{{ __db_group }}"
      release.DbRuntimeRoleName: "{{ __db_group }}"

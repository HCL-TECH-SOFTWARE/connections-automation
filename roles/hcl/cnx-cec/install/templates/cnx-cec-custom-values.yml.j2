{% if cnx_cec_web_engine_ltpa_secret_exists is defined and cnx_cec_web_engine_ltpa_secret_exists|bool|default(false) %}
    ltpa:
      # Pass the name of the LTPA secret to be used for LTPA configuration. The secret should contain the following keys:
      # - ltpa.keys
      # - password
      customLtpaSecret: "{{ __cnx_cec_web_engine_ltpa_secret_name }}"
{% endif %}
{% if cnx_cec_web_engine_trust_store_secret_exists is defined and cnx_cec_web_engine_trust_store_secret_exists|bool|default(false) %}
    customTruststoreSecrets:
      connections-cert: "{{ __trust_store_secret_name }}"
{% endif %}
# Probe overrides to tolerate longer startup (e.g. synchronous asset import)
probes:
  webEngine:
    startupProbe:
      initialDelaySeconds: {{ __cnx_cec_web_engine_startup_probe_initial_delay_seconds }}
      periodSeconds: {{ __cnx_cec_web_engine_startup_probe_period_seconds }}
      failureThreshold: {{ __cnx_cec_web_engine_startup_probe_failure_threshold }}
      successThreshold: {{ __cnx_cec_web_engine_startup_probe_success_threshold }}
      timeoutSeconds: {{ __cnx_cec_web_engine_startup_probe_timeout_seconds }}
    livenessProbe:
      failureThreshold: {{ __cnx_cec_web_engine_liveness_probe_failure_threshold }}
      periodSeconds: {{ __cnx_cec_web_engine_liveness_probe_period_seconds }}
      timeoutSeconds: {{ __cnx_cec_web_engine_liveness_probe_timeout_seconds }}
